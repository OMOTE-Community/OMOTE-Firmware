# NanoPB options for ESP32 optimization
# These options enable static allocation (no dynamic memory)
# by setting maximum sizes for all variable-length fields

# Global options for better performance on ESP32
* packed_struct:true

# RemoteEvent options - all fields use static buffers
omote.RemoteEvent.device max_size:32
omote.RemoteEvent.remote_id max_size:32
omote.RemoteEvent.data max_size:32

# CommandResult options - no dynamic allocation needed for message itself

# Nested message options - static buffers for all strings/bytes
omote.RawCommand.raw_response max_size:128
omote.Error.message max_size:128
omote.Metadata.title max_size:64
omote.Metadata.artist max_size:64
omote.Metadata.album max_size:64
omote.Metadata.state max_size:16
omote.PairingStatus.device_id max_size:32
omote.PairingStatus.step max_size:16
omote.PairingStatus.message max_size:128
omote.PairingStatus.context_token max_size:32

